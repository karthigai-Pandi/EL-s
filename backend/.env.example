NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://els:els_dev_password@localhost:5432/els_studio?schema=public
FRONTEND_ORIGINS=http://localhost:3000,https://your-vercel-domain.vercel.app
ADMIN_TOKEN=replace-with-at-least-32-random-characters

# Razorpay test credentials. Replace with live values only after verification.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Private S3-compatible bucket for artwork (AWS S3 or Cloudflare R2).
S3_REGION=ap-south-1
S3_BUCKET=replace-with-private-bucket
S3_ACCESS_KEY_ID=replace-with-access-key
S3_SECRET_ACCESS_KEY=replace-with-secret-key
S3_ENDPOINT=